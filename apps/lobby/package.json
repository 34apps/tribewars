{
  "name": "@clanfire/lobby",
  "version": "0.1.0",
  "private": true,
  "description": "Lobby service: one account for many worlds. Accounts, sessions, the world list and signed entry passes (Fastify + SQLite).",
  "type": "module",
  "scripts": {
    "dev": "DATABASE_PATH=${DATABASE_PATH:-./data/lobby.sqlite} NODE_ENV=development tsx watch src/index.ts",
    "start": "NODE_ENV=production node --enable-source-maps dist/index.js",
    "admin": "tsx src/admin.ts",
    "import": "tsx src/import.ts",
    "type-check": "tsc -p tsconfig.json",
    "test": "node --import tsx --test --test-timeout=60000 \"test/**/*.test.ts\"",
    "build": "node scripts/build.mjs",
    "backup": "tsx src/backup.ts",
    "gen:passwords": "tsx scripts/gen-common-passwords.ts"
  },
  "dependencies": {
    "@clanfire/engine": "*",
    "@fastify/cookie": "^11.1.5",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
