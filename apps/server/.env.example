# Clanfire server configuration. Copy to .env (git-ignored) or set in the process environment.
# Only ANTHROPIC_API_KEY (optional) is secret.

# Network
PORT=3000
HOST=0.0.0.0

# SQLite file (the folder is created if missing). Use ':memory:' for a throwaway world.
DATABASE_PATH=./data/clanfire.sqlite

# 'production' makes the session cookie Secure (HTTPS only). `npm start` sets it.
NODE_ENV=development

# Only behind a reverse proxy you control (uses X-Forwarded-For for rate limits).
# true/1 = trust one hop; a number >= 2 = that many proxy hops (e.g. CloudFront + ALB = 2);
# or a comma list of proxy IPs/CIDRs. Default: off.
# TRUST_PROXY=1

# Extra browser origins allowed to POST when the Host header differs from the public domain
# (CDN / load balancer). Comma list of scheme://host[:port], no path. Default: none.
# ALLOWED_ORIGINS=https://play.clanfire.com,https://clanfire.com

# Usernames (comma list) allowed to use sandbox/test mode. Default: metinaltinbas when NODE_ENV is
# not production, nobody in production. Set explicitly to enable it on a public server.
# SANDBOX_USERS=

# Most active accounts per IP at registration. Default: 3 in production, 0 (off) otherwise.
# MAX_ACCOUNTS_PER_IP=3

# World settings. They are read ONCE, when the database is created, and then stored in the
# database; changing them later has no effect (the server logs a warning). To reset, delete the DB.
# WORLD_SPEED=1      # multiplies production, divides every duration (dev uses 10)
# WORLD_SEED=20261102
# WORLD_RADIUS=100   # map spans -radius..+radius on both axes

# Mags the Tinker's AI advisor (POST /api/advisor/ask). OFF by default (owner, 2026-11-02: avoid AI spend; the web box was removed).
# Turn on only with ADVISOR_ENABLED=true plus a key. SECRET: set the key in apps/server/.env, never commit it.
# ADVISOR_ENABLED=false
ANTHROPIC_API_KEY=
