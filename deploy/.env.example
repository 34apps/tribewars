# Copy to deploy/.env (git-ignored). Read by docker compose for CADDY only; the game container never sees these.
# Subdomain that points at this instance's Elastic IP; CloudFront's /api/* origin. Not the public game domain.
ORIGIN_DOMAIN=origin.example.com
# Shared secret CloudFront sends as the X-Origin-Verify header. Generate: openssl rand -hex 32
ORIGIN_VERIFY_SECRET=change-me
# Optional, for backup.sh / update.sh (host side): S3 bucket for backups.
# BACKUP_BUCKET=my-clanfire-backups
