# Copy to deploy/.env (git-ignored) on the server. Read by docker compose and passed to the game container.

# --- Caddy (origin) ---
# Subdomain that points at this instance's Elastic IP; CloudFront's /api/* origin. Not the public game domain.
ORIGIN_DOMAIN=origin.example.com
# Shared secret CloudFront sends as the X-Origin-Verify header. Generate: openssl rand -hex 32
ORIGIN_VERIFY_SECRET=change-me

# --- Game server ---
NODE_ENV=production
# Socket peer = Caddy, then the CloudFront edge; the client address is the next hop.
TRUST_PROXY=2
# Public game domain (CloudFront), for the Origin check on writes.
ALLOWED_ORIGINS=https://play.example.com
MAX_ACCOUNTS_PER_IP=3

# World settings are read ONCE, when the database is first created.
# WORLD_SPEED=1
# WORLD_SEED=20261102
# WORLD_RADIUS=250
# WORLD_LAYOUT=expanding

# SANDBOX_USERS=      # empty = nobody (keep empty in production)
# ADVISOR_ENABLED=false
# ANTHROPIC_API_KEY=  # secret, only if the advisor is turned on
# BACKUP_KEEP=7
