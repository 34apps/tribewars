# Copy to deploy/lobby.env (git-ignored). Passed to the lobby container only (never to a world, never to Caddy).
# The lobby owns accounts and signs entry passes; see docs/MULTI_WORLD.md and deploy/README.md ("Lobby").
NODE_ENV=production
# Socket peer = Caddy, then the CloudFront edge; the client address is the next hop.
TRUST_PROXY=2
# Public game domain (CloudFront), for the Origin check on writes.
ALLOWED_ORIGINS=https://play.example.com
# One account per person: how many accounts one IP may register (the multi-account guard lives in the lobby).
MAX_ACCOUNTS_PER_IP=3
# BACKUP_KEEP=7

# REQUIRED SECRET: base64 PKCS#8 Ed25519 private key that signs entry passes. Whoever holds it can forge a pass for any
# world, so it lives ONLY in this file (git-ignored). Generate once (needs no database):
#   docker compose run --rm --no-deps lobby node admin.js keygen
# Put the LOBBY_SIGNING_KEY=... line it prints here and the LOBBY_PUBLIC_KEY=... line into every world's env file.
LOBBY_SIGNING_KEY=
