# Copy to deploy/lobby.env (git-ignored). Passed to the lobby container only (never to a world, never to Caddy).
# The lobby owns accounts and signs entry passes; see docs/MULTI_WORLD.md and deploy/README.md ("Lobby").
NODE_ENV=production
# Socket peer = Caddy, then the CloudFront edge; the client address is the next hop.
TRUST_PROXY=2
# Public game domain (CloudFront), for the Origin check on writes.
ALLOWED_ORIGINS=https://play.example.com
# One account per person: how many accounts one IP may register (the multi-account guard lives in the lobby).
MAX_ACCOUNTS_PER_IP=3
# BACKUP_KEEP=7

# REQUIRED SECRET: base64 PKCS#8 Ed25519 private key that signs entry passes. Whoever holds it can forge a pass for any
# world, so it lives ONLY in this file (git-ignored). Generate once (needs no database):
#   docker compose run --rm --no-deps lobby node admin.js keygen
# Put the LOBBY_SIGNING_KEY=... line it prints here and the LOBBY_PUBLIC_KEY=... line into every world's env file.
LOBBY_SIGNING_KEY=

# How the lobby reaches each world to delete or export a player's data there (account deletion, privacy export). `{id}` is the
# world id; the service name is `game-<id>` (see docker-compose.yml). Same compose network, plain http, no published port.
# A world on another machine: http://<that-host>:3000/w/{id}/api. Unset = deletions stay queued (and exports say "unavailable")
# until it is set; nothing is lost. Each world must have LOBBY_PUBLIC_KEY set, or it answers 404 to these commands.
WORLD_API_URL=http://game-{id}:3000/w/{id}/api

# Analytics (docs/ANALYTICS.md): anonymous play stats sent from this server to the owner's analytics service. Production only; leave off in dev.
# The SAME ANALYTICS_SALT must be set in the lobby and in every world (it makes one player id across worlds); keep it secret, never change it.
# ANALYTICS=1
# ANALYTICS_SALT=       # long random text, e.g. openssl rand -hex 32
# ANALYTICS_APP=        # e.g. 0.1.0-dev to mark a test play so it can be told apart
