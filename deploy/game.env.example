# Copy to deploy/game.env (git-ignored). Passed to the game container only.
# Every world has its OWN env file: game.env for w1, game-w2.env for w2 (also git-ignored), and so on.
# WORLD_ID is set in docker-compose.yml per service (letters, digits, dash; default w1); only the display name goes here.
# WORLD_NAME="Clanfire One"
NODE_ENV=production
# Socket peer = Caddy, then the CloudFront edge; the client address is the next hop.
TRUST_PROXY=2
# Public game domain (CloudFront), for the Origin check on writes.
ALLOWED_ORIGINS=https://play.example.com
MAX_ACCOUNTS_PER_IP=3

# Shared login through the lobby (docs/MULTI_WORLD.md). PUBLIC key(s) printed by `node admin.js keygen` / `public-key` in the
# lobby container, base64 SPKI, comma-separated (two keys during a key rotation). When set, this world accepts ONLY
# entry passes signed by the lobby and its own register/login are off. Empty/unset = the world keeps its own accounts.
# This is a public key, not a secret; never put LOBBY_SIGNING_KEY into a world's env file.
# LOBBY_PUBLIC_KEY=

# WORLD_ID=w1         # normally NOT set here: the compose `environment:` entry wins over this file
# World settings are read ONCE, when the database is first created.
# WORLD_SPEED=1
# WORLD_SEED=20261102
# WORLD_RADIUS=250
# WORLD_LAYOUT=expanding

# SANDBOX_USERS=      # empty = nobody (keep empty in production)
# ADVISOR_ENABLED=false
# ANTHROPIC_API_KEY=  # secret, only if the advisor is turned on
# BACKUP_KEEP=7
